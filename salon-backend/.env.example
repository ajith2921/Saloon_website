# ============================================
# QueueCut Backend — Environment Variables
# ============================================
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Supabase Project URL
# Found at: Supabase Dashboard → Settings → API → Project URL
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Service Role Key (keep secret! Never expose in frontend)
# Found at: Supabase Dashboard → Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Supabase JWT Secret (required for authenticated API routes)
# Found at: Supabase Dashboard → Settings → API → JWT Settings → JWT Secret
SUPABASE_JWT_SECRET=your-jwt-secret-here

# Comma-separated allowed frontend origins for CORS
FRONTEND_URL=http://localhost:5173,http://localhost:3000

# ============================================
# Razorpay Billing Provider (Phase K3.3.2)
# ============================================
# Generate these from the Razorpay Dashboard -> Settings -> API Keys
RAZORPAY_KEY_ID=rzp_test_example12345
RAZORPAY_KEY_SECRET=your-razorpay-key-secret-here

# Generate a webhook secret and configure it in the Razorpay Webhooks dashboard
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret-here
